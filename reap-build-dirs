#!/usr/bin/env bash
# reap-build-dirs: delete stale Rust and Terraform build output from throwaway
# worktrees and temp dirs, so many parallel checkouts can't fill the disk.
#
# Usage: reap-build-dirs [-n|--dry-run] [-h|--help]
# Configuration is by environment variable; see --help.
set -u

usage() {
  cat <<'EOF'
Usage: reap-build-dirs [-n|--dry-run] [-h|--help]

Deletes build output nothing has written to for REAP_AGE_DAYS:
  - cargo build dirs under REAP_ROOTS and the temp dirs
  - .terraform dirs in linked git worktrees under REAP_ROOTS
and wipes REAP_SHARED_BUILD_DIR once it grows past REAP_SHARED_CAP_GB.

Never touched: a main checkout's own target/ and .terraform/, any module with
local Terraform state, any .terraform with a non-default workspace selected.

Environment:
  REAP_ROOTS             colon-separated dirs to search  (default: $HOME/git)
  REAP_TEMP_ROOTS        colon-separated temp dirs, searched 4 levels deep
                         (default: /tmp, $TMPDIR and, on macOS, the
                         per-user temp dir)
  REAP_AGE_DAYS          idle days before a dir is deleted, at least 1  (default: 3)
  REAP_LOW_FREE_GB       below this much free disk, cargo build dirs are deleted
                         after REAP_LOW_FREE_AGE_HOURS instead; 0 turns it off
                         (default: 150)
  REAP_LOW_FREE_AGE_HOURS  idle hours before a cargo build dir is deleted when
                         the disk is low, at least 1  (default: 16)
  REAP_TERRAFORM         0 to skip .terraform dirs, 1 to include them  (default: 1)
  REAP_SHARED_BUILD_DIR  a cargo build-dir shared across workspaces  (default: unset)
  REAP_SHARED_CAP_GB     size that triggers wiping it  (default: 100)
  DRY_RUN                1 to report without deleting  (same as --dry-run)
EOF
}

DRY_RUN=${DRY_RUN:-0}
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "reap-build-dirs: unknown argument: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

AGE_DAYS=${REAP_AGE_DAYS:-3}
ROOTS=${REAP_ROOTS:-$HOME/git}
# On macOS the per-user temp dir is found directly: cron may not set TMPDIR.
TEMP_ROOTS=${REAP_TEMP_ROOTS:-/tmp:${TMPDIR:-}:$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null)}
TERRAFORM=${REAP_TERRAFORM:-1}
SHARED_DIR=${REAP_SHARED_BUILD_DIR:-}
SHARED_CAP_GB=${REAP_SHARED_CAP_GB:-100}
LOW_FREE_GB=${REAP_LOW_FREE_GB:-150}
LOW_FREE_AGE_HOURS=${REAP_LOW_FREE_AGE_HOURS:-16}

die() { echo "reap-build-dirs: $*" >&2; exit 2; }
case "$TERRAFORM" in 0|1) ;; *) die "REAP_TERRAFORM must be 0 or 1 (got '$TERRAFORM')" ;; esac
# Leading zeros would make bash read a number as octal. Past 9 digits a size in KB
# overflows bash's 64-bit arithmetic and wraps negative. A bad age would reach find
# as an invalid -mmin and make every dir look idle.
whole_num() { # $1 = variable name, $2 = value, $3 = minimum; prints it without leading zeros
  case "$2" in ''|*[!0-9]*) die "$1 must be a whole number, at least $3 (got '$2')" ;; esac
  local n=${2#"${2%%[!0]*}"}
  [ ${#n} -le 9 ] || die "$1 must be at most 999999999 (got '$2')"
  [ "${n:-0}" -ge "$3" ] || die "$1 must be a whole number, at least $3 (got '$2')"
  echo "${n:-0}"
}
AGE_DAYS=$(whole_num REAP_AGE_DAYS "$AGE_DAYS" 1) || exit 2
SHARED_CAP_GB=$(whole_num REAP_SHARED_CAP_GB "$SHARED_CAP_GB" 0) || exit 2
LOW_FREE_GB=$(whole_num REAP_LOW_FREE_GB "$LOW_FREE_GB" 0) || exit 2
LOW_FREE_AGE_HOURS=$(whole_num REAP_LOW_FREE_AGE_HOURS "$LOW_FREE_AGE_HOURS" 1) || exit 2
# git tells a main checkout from a worktree. Without it a main checkout's target/
# would look unprotected, so don't run at all.
git --version >/dev/null 2>&1 || die "git must be runnable to recognize main checkouts ('git --version' failed)"

log() { echo "$(date '+%F %T') $*"; }
gib() { awk -v k="$1" 'BEGIN { printf "%.1f", k / 1048576 }'; }
free_kb() { df -Pk "$HOME" | awk 'NR==2 {print $4}'; }
free_gib() { gib "$(free_kb)"; }
# Minutes, not -mtime days: BSD and GNU find round days differently, and low-disk
# mode needs hours.
recent() { # $1 = minutes, $2.. = find args; true if anything was written in that
           # time, or if find can't tell
  local min=$1 out; shift
  out=$(find "$@" -mmin -"$min" -print -quit 2>/dev/null) || return 0
  [ -n "$out" ]
}
each_dir() { # split a colon list, keeping only existing dirs
  local IFS=:
  for r in $1; do [ -n "$r" ] && [ -d "$r" ] && (cd "$r" && pwd -P); done | sort -u
}

reap() { # $1 = dir, $2 = reason
  local kb; kb=$(du -sk "$1" 2>/dev/null | cut -f1)
  if [ "$DRY_RUN" = 1 ]; then
    log "would delete $(gib "${kb:-0}") GiB  $1  ($2)"
  elif rm -rf "$1"; then
    log "deleted $(gib "${kb:-0}") GiB  $1  ($2)"
  else
    log "FAILED  $1"
    failures=$((failures + 1))
  fi
}

# A linked worktree has its own git dir; a main checkout's git dir is the
# repo's common dir. Prints nothing outside a git repo.
checkout_kind() {
  local gd common
  gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  common=$(cd "$1" && cd "$(git rev-parse --git-common-dir)" && pwd -P)
  [ "$gd" = "$common" ] && echo main || echo linked
}

# True for the top level of a main checkout, not for a dir inside one: only the
# main checkout's own target/ holds the build state worth keeping.
main_checkout_root() {
  [ "$(checkout_kind "$1")" = main ] &&
    [ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" = "$1" ]
}

# Cargo writes CACHEDIR.TAG and/or .rustc_info.json at a build dir's root, and
# some dirs have only one, so search for both. Matching the name `target` would
# miss custom build dirs and hit crate sources that contain a `target/` module.
cargo_candidates() { # $1 = root, $2.. = extra find args
  local root=$1; shift
  # debug/build holds one dir per crate in cargo's newer layout: thousands, no markers.
  find "$root" "$@" \( -name .git -o -name node_modules -o -name deps -o -name incremental \
      -o -path '*/debug/build' -o -path '*/release/build' \) -prune \
    -o \( -name CACHEDIR.TAG -o -name .rustc_info.json \) -print 2>/dev/null \
    | grep -v '/registry/src/' | while IFS= read -r f; do dirname "$f"; done
}

shared_real=""
[ -n "$SHARED_DIR" ] && [ -d "$SHARED_DIR" ] && shared_real=$(cd "$SHARED_DIR" && pwd -P)

# Run from the binary, which logs the start and done lines itself.
FROM_BINARY=${REAP_FROM_BINARY:-0}
free_at_start=$(free_kb)
[ "$FROM_BINARY" = 1 ] || log "start (free $(gib "$free_at_start") GiB, age ${AGE_DAYS}d, dry_run=$DRY_RUN)"

# reap() counts failed deletes here. The loops below that call it read from
# process substitution, not a pipe: a piped loop runs in a subshell and its count
# would be lost.
failures=0

age_min=$((AGE_DAYS * 1440))
# Low on disk: cargo build dirs go after hours instead of days. Only ever lower.
cargo_min=$age_min cargo_reason="cargo, idle ${AGE_DAYS}d+"
if [ "$LOW_FREE_GB" -gt 0 ] && [ "$free_at_start" -lt $((LOW_FREE_GB * 1048576)) ] &&
   [ $((LOW_FREE_AGE_HOURS * 60)) -lt "$age_min" ]; then
  log "low disk (free $(gib "$free_at_start") GiB < ${LOW_FREE_GB} GiB): cargo build dirs idle ${LOW_FREE_AGE_HOURS}h+ are deleted"
  cargo_min=$((LOW_FREE_AGE_HOURS * 60)) cargo_reason="cargo, idle ${LOW_FREE_AGE_HOURS}h+, low disk"
fi

# Shortest paths first, so a nested build dir is skipped once its parent is gone.
while IFS= read -r d; do
  [ -d "$d" ] || continue
  [ -O "$d" ] || continue                       # another user's: theirs to clean up
  case "$d" in "$shared_real"|"$shared_real"/*) [ -n "$shared_real" ] && continue ;; esac
  # deps/ until Rust 1.100; build/ in the layout that replaced it.
  is_build=0
  for p in "$d"/{debug,release}/{deps,build}; do [ -d "$p" ] && is_build=1 && break; done
  [ "$is_build" = 1 ] || continue
  if [ "$(basename "$d")" = target ] && main_checkout_root "$(dirname "$d")"; then
    continue                                    # main checkout's incremental state
  fi
  recent "$cargo_min" "$d" && continue
  reap "$d" "$cargo_reason"
done < <(
  {
    each_dir "$ROOTS" | while IFS= read -r r; do cargo_candidates "$r"; done
    each_dir "$TEMP_ROOTS" | while IFS= read -r r; do cargo_candidates "$r" -maxdepth 4; done
  } | sort -u | awk '{ print length, $0 }' | sort -n | cut -d' ' -f2-
)

# .terraform holds downloaded providers and backend settings; with remote state,
# `terraform init` restores it. Only linked worktrees are touched.
if [ "$TERRAFORM" = 1 ]; then
  while IFS= read -r d; do
    [ -O "$d" ] || continue                     # another user's: theirs to clean up
    m=$(dirname "$d")
    # Local state. A dangling link may point at state that comes back.
    [ -e "$m/terraform.tfstate" ] || [ -L "$m/terraform.tfstate" ] || [ -d "$m/terraform.tfstate.d" ] && continue
    # Re-init would silently switch back to `default`, so a later apply could
    # hit the wrong workspace.
    if [ -f "$d/environment" ] && [ "$(cat "$d/environment")" != default ]; then
      continue
    fi
    [ "$(checkout_kind "$m")" = linked ] || continue
    # Providers land deep inside .terraform; module edits show at its top level.
    { recent "$age_min" "$d" || recent "$age_min" "$m" -maxdepth 1; } && continue
    reap "$d" "terraform, idle ${AGE_DAYS}d+"
  done < <(
    each_dir "$ROOTS" | while IFS= read -r r; do
      find "$r" \( -name .git -o -name node_modules \) -prune -o -type d -name .terraform -prune -print 2>/dev/null
    done
  )
fi

# A shared build-dir is written by every workspace, so it is never idle. Wipe it
# whole past the cap, but only while no cargo build is running.
if [ -n "$shared_real" ]; then
  shared_kb=$(du -sk "$shared_real" | cut -f1)
  if [ "$shared_kb" -gt $((SHARED_CAP_GB * 1048576)) ]; then
    if pgrep -x cargo >/dev/null || pgrep -x rustc >/dev/null; then
      log "skip $shared_real ($(gib "$shared_kb") GiB): cargo is building, retry next run"
    else
      reap "$shared_real" "shared build-dir over ${SHARED_CAP_GB} GiB"
    fi
  fi
fi

[ "$FROM_BINARY" = 1 ] || log "done (free $(free_gib) GiB)"
# Finish every delete first, then report failure so a scheduler shows it.
[ "$failures" = 0 ] || exit 1
